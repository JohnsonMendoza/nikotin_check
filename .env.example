# ============================================================
# ШАБЛОН НАСТРОЕК. Скопируй этот файл в .env и заполни BOT_TOKEN.
#   Windows:  copy .env.example .env
#   macOS/Linux:  cp .env.example .env
# Файл .env НЕ выкладывать в GitHub (он уже в .gitignore).
# ============================================================

# Токен от @BotFather. Единственная обязательная строка.
BOT_TOKEN=1234567890:AAExampleExampleExampleExampleExample

# --- Хранение данных -----------------------------------------
# Путь к базе SQLite. Папка создаётся автоматически.
DB_PATH=data/bot.sqlite3

# --- Время ---------------------------------------------------
# Часовой пояс для счётчика дней и утренних уведомлений (СПб = Москва).
TIMEZONE=Europe/Moscow
# Час утреннего уведомления по умолчанию (0-23), пользователь может изменить.
DEFAULT_NOTIFY_HOUR=9

# --- Режим работы --------------------------------------------
# polling — бот сам спрашивает Telegram об обновлениях (локальный запуск, VPS).
# webhook — Telegram сам присылает обновления на наш HTTP-адрес (Render, PythonAnywhere).
MODE=polling

# Нужно только при MODE=webhook:
# Публичный HTTPS-адрес сервиса, БЕЗ слэша на конце.
WEBHOOK_BASE_URL=https://your-service.onrender.com
# Порт HTTP-сервера. На Render/Railway переменная PORT задаётся платформой автоматически.
PORT=8080
# Секрет для URL плановых задач (/cron/<ключ>). Придумай длинную случайную строку.
CRON_KEY=change-me-to-random-string
# Прокси для исходящих запросов к api.telegram.org (нужно на бесплатном PythonAnywhere).
# Пример: http://proxy.server:3128
PROXY_URL=

# --- Служебное -----------------------------------------------
# Твой numeric user_id (узнать: @userinfobot). Даёт доступ к команде /stats (только агрегаты).
ADMIN_ID=
# Ускорение SOS-практики для демонстрации на защите: 1 = реальные 2 минуты, 0.05 = 6 секунд.
SOS_TIME_SCALE=1
